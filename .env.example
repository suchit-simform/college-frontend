# Base URL for every API call. The default is relative, so requests go through the
# Vite dev proxy (pnpm dev) or nginx (Docker), which forward /api to the backend.
# Or call the backend directly (its CORS_ORIGIN must include this app's origin):
# VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_BASE_URL=/api/v1

VITE_FEATURE_DEPARTMENT=false
